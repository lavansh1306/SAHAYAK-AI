# --- LLM (Local Ollama) ------------------------------------------------------
# Ollama runs locally on http://127.0.0.1:11434 with model 'qwen3:4b'
# Ensure Ollama is running (`ollama serve`) and model is pulled (`ollama pull qwen3:4b`).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Set to false to run fully rule-based (no LLM calls)
LLM_ENABLED=true
# One-line "in simple words" summary written by the LLM (numbers verified). false = computed text only
LLM_NARRATION=true
# Timeout in seconds (default 120s for CPU-based local execution)
LLM_TIMEOUT_SECONDS=120

# --- Dates -------------------------------------------------------------------
# Optional: fix 'today' (YYYY-MM-DD) so relative questions like "last month" are reproducible
AS_OF_DATE=
