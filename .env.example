# --- LLM (OpenRouter) -------------------------------------------------------
# Get a free key at https://openrouter.ai/keys and paste it below.
OPENROUTER_API_KEY=
# 'openrouter/free' routes each request to an available free model.
# For more consistent behaviour you can pin one free model, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Set to false to run fully rule-based (no network calls at all)
LLM_ENABLED=true
# One-line "in simple words" summary written by the LLM (numbers verified). false = computed text only
LLM_NARRATION=true
LLM_TIMEOUT_SECONDS=45

# --- Dates -------------------------------------------------------------------
# Optional: fix 'today' (YYYY-MM-DD) so relative questions like "last month" are reproducible
AS_OF_DATE=
